 }
 
+func (channel *Channel) Successor() string {
+	channel.stateMutex.RLock()
+	defer channel.stateMutex.RUnlock()
+	return channel.successor
+}
+
+func (channel *Channel) SetSuccessor(account string) {
+	defer channel.MarkDirty(IncludeSettings)
+
+	channel.stateMutex.Lock()
+	defer channel.stateMutex.Unlock()
+	channel.successor = account
+}
+
 // JoinLimit returns the channel's join limit, or nil when it has none.
 func (channel *Channel) JoinLimit() *ChannelJoinLimit {
 	channel.stateMutex.RLock()
