diff --git a/irc/chanserv.go b/irc/chanserv.go
index f33fdb2f..ebe88aac 100644
--- a/irc/chanserv.go
+++ b/irc/chanserv.go
@@ -219,6 +219,18 @@ within that many seconds. The founder and channel admins can set it.`,
 			enabled:      chanregEnabled,
 			minParams:    2,
 		},
+		"successor": {
+			handler: csSuccessorHandler,
+			help: `Syntax: $bSUCCESSOR #channel [account]$b
+
+SUCCESSOR names the account that the channel passes to if the founder's account
+is unregistered. Without an account, it clears the successor. Only the founder
+can use it.`,
+			helpShort:    `$bSUCCESSOR$b names who gets the channel if the founder's account goes.`,
+			authRequired: true,
+			enabled:      chanregEnabled,
+			minParams:    1,
+		},
 		"note": {
 			handler: csNoteHandler,
 			help: `Syntax: $bNOTE #channel ADD <text>$b
@@ -1222,3 +1234,23 @@ func csJoinLimitHandler(service *ircService, server *Server, client *Client, com
 	channel.SetJoinLimit(&ChannelJoinLimit{Joins: joins, Seconds: seconds})
 	service.Notice(rb, fmt.Sprintf(client.t("%s now takes at most %d joins every %d seconds"), channel.Name(), joins, seconds))
 }
+
+func csSuccessorHandler(service *ircService, server *Server, client *Client, command string, params []string, rb *ResponseBuffer) {
+	channel := server.channels.Get(params[0])
+	if channel == nil || !channel.IsRegistered() || channel.Founder() != client.Account() {
+		service.Notice(rb, client.t("Insufficient privileges"))
+		return
+	}
+	if len(params) == 1 {
+		channel.SetSuccessor("")
+		service.Notice(rb, fmt.Sprintf(client.t("Cleared the successor of %s"), channel.Name()))
+		return
+	}
+	account, err := server.accounts.LoadAccount(params[1])
+	if err != nil {
+		service.Notice(rb, client.t("Account does not exist"))
+		return
+	}
+	channel.SetSuccessor(account.NameCasefolded)
+	service.Notice(rb, fmt.Sprintf(client.t("%[2]s will get %[1]s if your account is unregistered"), channel.Name(), account.Name))
+}
