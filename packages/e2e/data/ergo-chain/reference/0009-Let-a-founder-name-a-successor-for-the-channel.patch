Date: Tue, 17 Nov 2026 19:43:45 -0800
Subject: [PATCH 09/12] Let a founder name a successor for the channel

---
 default.yaml      |  4 ++--
 irc/accounts.go   | 49 +++++++++++++++++++++++++++++++++++++++++++++++
 irc/channel.go    |  4 ++++
 irc/channelreg.go |  2 ++
 irc/chanserv.go   | 32 +++++++++++++++++++++++++++++++
 irc/config.go     |  8 ++++----
 irc/getters.go    | 14 ++++++++++++++
 traditional.yaml  |  4 ++--
 8 files changed, 109 insertions(+), 8 deletions(-)

diff --git a/default.yaml b/default.yaml
index ca58eedc..f4d869e8 100644
--- a/default.yaml
+++ b/default.yaml
@@ -703,10 +703,10 @@ channels:
 
         # a registered channel that nobody with an account has joined for this long
         # loses its registration (0 turns expiry off); its founder is mailed
-        expire-after: 60d
+        expire-after: 90d
 
         # the founder is warned by mail this long before that
-        expire-warning: 7d
+        expire-warning: 14d
 
     # as a crude countermeasure against spambots, anonymous connections younger
     # than this value will get an empty response to /LIST (a time period of 0 disables)
diff --git a/irc/accounts.go b/irc/accounts.go
index d7428cab..2dc05861 100644
--- a/irc/accounts.go
+++ b/irc/accounts.go
@@ -4,12 +4,15 @@
 package irc
 
 import (
+	"bytes"
 	"context"
 	"crypto/rand"
 	"crypto/x509"
 	"encoding/json"
+	"errors"
 	"fmt"
 	"net"
+	"net/textproto"
 	"sort"
 	"strconv"
 	"strings"
@@ -27,6 +30,7 @@ import (
 	"github.com/ergochat/ergo/irc/modes"
 	"github.com/ergochat/ergo/irc/oauth2"
 	"github.com/ergochat/ergo/irc/passwd"
+	"github.com/ergochat/ergo/irc/sno"
 	"github.com/ergochat/ergo/irc/utils"
 )
 
@@ -1939,12 +1943,57 @@ func (am *AccountManager) Unregister(account string, erase bool) error {
 
 	// on our way out, unregister all the account's channels and delete them from the db
 	defer func() {
+		config := am.server.Config()
+		network := config.Network.Name
+		type outgoing struct{ to, subject, body string }
+		var outbox []outgoing
 		for _, channelName := range am.server.channels.ChannelsForAccount(casefoldedAccount, true) {
+			if channel := am.server.channels.Get(channelName); channel != nil && channel.Successor() != "" {
+				successor, loadErr := am.LoadAccount(channel.Successor())
+				if _, transferErr := channel.Transfer(nil, channel.Successor(), true); loadErr == nil && transferErr == nil {
+					channel.SetSuccessor("")
+					name := channel.Name()
+					am.server.snomasks.Send(sno.LocalChannels, fmt.Sprintf("%s passed to its successor, account %s", name, successor.Name))
+					for _, c := range am.AccountToClients(successor.NameCasefolded) {
+						c.Send(nil, chanservService.prefix, "NOTICE", c.Nick(), fmt.Sprintf("[%s] %s", name, c.t("You are now the founder of this channel")))
+					}
+					if successor.Settings.Email != "" {
+						body := fmt.Sprintf("The founder's account is gone, so you are now the founder of %s.\r\n", name)
+						if after := time.Duration(*config.Channels.Registration.ExpireAfter); after > 0 {
+							body += fmt.Sprintf("Its registration expires if nobody with an account joins it for %d days.\r\n", int(after.Hours()/24))
+						}
+						outbox = append(outbox, outgoing{successor.Settings.Email, fmt.Sprintf("[%s] You are now the founder of %s", network, name), body})
+					}
+					continue
+				}
+			}
 			err := am.server.channels.SetUnregistered(channelName, casefoldedAccount)
 			if err != nil {
 				am.server.logger.Error("internal", "couldn't unregister channel", channelName, err.Error())
 			}
 		}
+		go func() {
+			mailConfig := config.Accounts.Registration.EmailVerification
+			for _, m := range outbox {
+				message := email.ComposeMail(mailConfig, m.to, m.subject)
+				message = *bytes.NewBuffer(bytes.Replace(message.Bytes(), []byte("\r\n\r\n"), []byte("\r\nAuto-Submitted: auto-generated\r\n\r\n"), 1))
+				message.WriteString(m.body + "\r\n-- " + network + " staff\r\n")
+				var err error
+				for attempt := 0; attempt < 3; attempt++ {
+					if err = email.SendMail(mailConfig, m.to, message.Bytes()); err == nil {
+						break
+					}
+					var smtpErr *textproto.Error
+					if !errors.As(err, &smtpErr) || smtpErr.Code/100 != 4 {
+						break
+					}
+					time.Sleep(3 * time.Second)
+				}
+				if err != nil {
+					am.server.logger.Error("internal", "Failed to mail the successor of a channel", m.to, err.Error())
+				}
+			}
+		}()
 	}()
 
 	var credText string
