diff --git a/irc/getters.go b/irc/getters.go
index 9b722f87..55670153 100644
--- a/irc/getters.go
+++ b/irc/getters.go
@@ -828,6 +828,32 @@ func (channel *Channel) SetExpiryWarned() {
 	channel.expiryWarned = true
 }
 
+// rememberJoin notes that the account joined now, and says whether it had already joined within `window`.
+func (channel *Channel) rememberJoin(account string, window time.Duration) (regular bool) {
+	channel.stateMutex.Lock()
+	defer channel.stateMutex.Unlock()
+	if channel.lastJoinByAccount == nil {
+		channel.lastJoinByAccount = make(map[string]time.Time)
+	}
+	last, seen := channel.lastJoinByAccount[account]
+	channel.lastJoinByAccount[account] = time.Now()
+	return seen && time.Since(last) < window
+}
+
+func (channel *Channel) Regulars() string {
+	channel.stateMutex.RLock()
+	defer channel.stateMutex.RUnlock()
+	return channel.regulars
+}
+
+func (channel *Channel) SetRegulars(text string) {
+	defer channel.MarkDirty(IncludeSettings)
+
+	channel.stateMutex.Lock()
+	defer channel.stateMutex.Unlock()
+	channel.regulars = text
+}
+
 func (channel *Channel) Successor() string {
 	channel.stateMutex.RLock()
 	defer channel.stateMutex.RUnlock()
