 7 files changed, 73 insertions(+), 6 deletions(-)

diff --git a/default.yaml b/default.yaml
index f4d869e8..1fc73901 100644
--- a/default.yaml
+++ b/default.yaml
@@ -708,6 +708,10 @@ channels:
         # the founder is warned by mail this long before that
         expire-warning: 14d
 
+        # someone whose account joined a channel within this long gets the channel's
+        # welcome-back message (CS ENTRYMSG #channel REGULARS) instead of its greeting
+        regulars-window: 24h
+
     # as a crude countermeasure against spambots, anonymous connections younger
     # than this value will get an empty response to /LIST (a time period of 0 disables)
     list-delay: 0s
