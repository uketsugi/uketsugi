 }
@@ -372,6 +376,8 @@ func (channel *Channel) SetUnregistered(expectedFounder string) {
 	channel.expiryWarned = false
 	channel.joinLimit = nil
 	channel.successor = ""
+	channel.regulars = ""
+	channel.lastJoinByAccount = nil
 	// reset the UUID so that any re-registration will persist under
 	// a separate key:
 	channel.uuid = uuid
@@ -1003,7 +1009,13 @@ func (channel *Channel) Join(client *Client, key string, isSajoin bool, rb *Resp
 		channel.SetLastUsed(time.Now().UTC())
