 		},
 		"joinlimit": {
 			handler: csJoinLimitHandler,
@@ -1100,11 +1102,24 @@ func csEntrymsgHandler(service *ircService, server *Server, client *Client, comm
 	if refuseWhileFrozen(service, channel, client, rb) {
 		return
 	}
-	greeting := strings.Join(params[1:], " ")
+	text := ""
+	if len(params) > 1 {
+		text = params[1]
+	}
+	regulars := false
+	if word, rest, _ := strings.Cut(text, " "); strings.EqualFold(word, "regulars") {
+		regulars, text = true, strings.TrimLeft(rest, " ")
+	}
+	greeting := text
 	if limit := server.Config().Channels.Registration.GreetingMaxLength; utf8.RuneCountInString(greeting) > limit {
 		service.Notice(rb, fmt.Sprintf(client.t("Greetings can be at most %d characters long"), limit))
 		return
 	}
+	if regulars {
+		channel.SetRegulars(greeting)
+		service.Notice(rb, fmt.Sprintf(client.t("Set the welcome-back message for %s"), channel.Name()))
+		return
+	}
 	channel.SetGreeting(greeting, client.AccountName(), channel.Founder() != client.Account())
 	if greeting == "" {
 		service.Notice(rb, fmt.Sprintf(client.t("Removed the greeting for %s"), channel.Name()))
