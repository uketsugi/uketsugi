From c0c8c6735854e39bbe0b9a6590814d7c5c3fb188 Mon Sep 17 00:00:00 2001
From: bench <bench@example.invalid>
Date: Tue, 17 Nov 2026 19:33:49 -0800
Subject: [PATCH 05/12] Make the greeting and note limits configurable

---
 default.yaml     |  7 +++++++
 irc/chanserv.go  | 15 +++++++--------
 irc/config.go    | 12 ++++++++++++
 traditional.yaml |  7 +++++++
 4 files changed, 33 insertions(+), 8 deletions(-)

diff --git a/default.yaml b/default.yaml
index ea1e5029..b7a70a32 100644
--- a/default.yaml
+++ b/default.yaml
@@ -694,6 +694,13 @@ channels:
         # how many channels can each account register?
         max-channels-per-account: 15
 
+        # the longest greeting a founder can set with CS ENTRYMSG, in characters
+        greeting-max-length: 200
+
+        # how many staff notes a channel can hold, and the longest note, in characters
+        notes-max: 25
+        note-max-length: 300
+
     # as a crude countermeasure against spambots, anonymous connections younger
     # than this value will get an empty response to /LIST (a time period of 0 disables)
     list-delay: 0s
diff --git a/irc/chanserv.go b/irc/chanserv.go
index f6eaf15b..479e0aee 100644
--- a/irc/chanserv.go
+++ b/irc/chanserv.go
@@ -1036,8 +1036,6 @@ func csHowToBanHandler(service *ircService, server *Server, client *Client, comm
 	}
 }
 
-const maxGreetingLength = 200
-
 func csEntrymsgHandler(service *ircService, server *Server, client *Client, command string, params []string, rb *ResponseBuffer) {
 	channel := server.channels.Get(params[0])
 	if channel == nil || !channel.IsRegistered() {
@@ -1056,8 +1054,8 @@ func csEntrymsgHandler(service *ircService, server *Server, client *Client, comm
 		return
 	}
 	greeting := strings.Join(params[1:], " ")
-	if utf8.RuneCountInString(greeting) > maxGreetingLength {
-		service.Notice(rb, fmt.Sprintf(client.t("Greetings can be at most %d characters long"), maxGreetingLength))
+	if limit := server.Config().Channels.Registration.GreetingMaxLength; utf8.RuneCountInString(greeting) > limit {
+		service.Notice(rb, fmt.Sprintf(client.t("Greetings can be at most %d characters long"), limit))
 		return
 	}
 	channel.SetGreeting(greeting, client.AccountName(), channel.Founder() != client.Account())
@@ -1068,8 +1066,6 @@ func csEntrymsgHandler(service *ircService, server *Server, client *Client, comm
 	}
 }
 
-const maxChannelNotes = 10
-
 func csNoteHandler(service *ircService, server *Server, client *Client, command string, params []string, rb *ResponseBuffer) {
 	channel := server.channels.Get(params[0])
 	if channel == nil || !channel.IsRegistered() || !(channel.Founder() == client.Account() || client.HasRoleCapabs("chanreg")) {
@@ -1086,8 +1082,11 @@ func csNoteHandler(service *ircService, server *Server, client *Client, command
 			service.Notice(rb, client.t("Invalid parameters"))
 			return
 		}
-		if id := channel.AddNote(client.Account(), text, maxChannelNotes); id == 0 {
-			service.Notice(rb, fmt.Sprintf(client.t("%s already has the maximum of %d notes"), channel.Name(), maxChannelNotes))
+		config := server.Config().Channels.Registration
+		if utf8.RuneCountInString(text) > config.NoteMaxLength {
+			service.Notice(rb, fmt.Sprintf(client.t("Notes can be at most %d characters long"), config.NoteMaxLength))
+		} else if id := channel.AddNote(client.Account(), text, config.NotesMax); id == 0 {
+			service.Notice(rb, fmt.Sprintf(client.t("%s already has the maximum of %d notes"), channel.Name(), config.NotesMax))
 		} else {
 			service.Notice(rb, fmt.Sprintf(client.t("Added note #%d to %s"), id, channel.Name()))
 		}
diff --git a/irc/config.go b/irc/config.go
index 7a149491..4048197c 100644
--- a/irc/config.go
+++ b/irc/config.go
@@ -691,6 +691,9 @@ type Config struct {
 			Enabled               bool
 			OperatorOnly          bool `yaml:"operator-only"`
 			MaxChannelsPerAccount int  `yaml:"max-channels-per-account"`
+			GreetingMaxLength     int  `yaml:"greeting-max-length"`
+			NotesMax              int  `yaml:"notes-max"`
+			NoteMaxLength         int  `yaml:"note-max-length"`
 		}
 		ListDelay        time.Duration    `yaml:"list-delay"`
 		InviteExpiration custime.Duration `yaml:"invite-expiration"`
@@ -1712,6 +1715,15 @@ func LoadConfig(filename string) (config *Config, err error) {
 	if config.Channels.Registration.MaxChannelsPerAccount == 0 {
 		config.Channels.Registration.MaxChannelsPerAccount = 15
 	}
+	if config.Channels.Registration.GreetingMaxLength == 0 {
+		config.Channels.Registration.GreetingMaxLength = 200
+	}
+	if config.Channels.Registration.NotesMax == 0 {
+		config.Channels.Registration.NotesMax = 25
+	}
+	if config.Channels.Registration.NoteMaxLength == 0 {
+		config.Channels.Registration.NoteMaxLength = 300
+	}
 
 	config.Server.Compatibility.forceTrailing = utils.BoolDefaultTrue(config.Server.Compatibility.ForceTrailing)
 	config.Server.Compatibility.allowTruncation = utils.BoolDefaultTrue(config.Server.Compatibility.AllowTruncation)
diff --git a/traditional.yaml b/traditional.yaml
index 8b9c396d..29103aa3 100644
--- a/traditional.yaml
+++ b/traditional.yaml
@@ -665,6 +665,13 @@ channels:
         # how many channels can each account register?
         max-channels-per-account: 15
 
+        # the longest greeting a founder can set with CS ENTRYMSG, in characters
+        greeting-max-length: 200
+
+        # how many staff notes a channel can hold, and the longest note, in characters
+        notes-max: 25
+        note-max-length: 300
+
     # as a crude countermeasure against spambots, anonymous connections younger
     # than this value will get an empty response to /LIST (a time period of 0 disables)
     list-delay: 0s
-- 
2.34.1

