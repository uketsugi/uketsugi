 }
+
+const maxChannelNotes = 10
+
+func csNoteHandler(service *ircService, server *Server, client *Client, command string, params []string, rb *ResponseBuffer) {
+	channel := server.channels.Get(params[0])
+	if channel == nil || !channel.IsRegistered() || !(channel.Founder() == client.Account() || client.HasRoleCapabs("chanreg")) {
+		service.Notice(rb, client.t("Insufficient privileges"))
+		return
+	}
+	switch strings.ToLower(params[1]) {
+	case "add":
+		text := strings.Join(params[2:], " ")
+		if text == "" {
+			service.Notice(rb, client.t("Invalid parameters"))
+			return
+		}
+		if id := channel.AddNote(client.Account(), text, maxChannelNotes); id == 0 {
+			service.Notice(rb, fmt.Sprintf(client.t("%s already has the maximum of %d notes"), channel.Name(), maxChannelNotes))
+		} else {
+			service.Notice(rb, fmt.Sprintf(client.t("Added note #%d to %s"), id, channel.Name()))
+		}
+	case "list":
+		notes := channel.Notes()
+		if len(notes) == 0 {
+			service.Notice(rb, fmt.Sprintf(client.t("%s has no notes"), channel.Name()))
+		}
+		for i := len(notes) - 1; i >= 0; i-- {
+			n := notes[i]
+			service.Notice(rb, fmt.Sprintf("#%d %s UTC %s: %s", n.ID, n.Time.UTC().Format("2006-01-02 15:04"), n.Account, n.Text))
+		}
+	case "del":
+		id, err := strconv.Atoi(strings.TrimPrefix(strings.Join(params[2:], ""), "#"))
+		if err != nil || !channel.DeleteNote(id) {
+			service.Notice(rb, client.t("No such note"))
+			return
+		}
+		service.Notice(rb, fmt.Sprintf(client.t("Deleted note #%d from %s"), id, channel.Name()))
+	default:
+		service.Notice(rb, client.t("Invalid parameters"))
+	}
+}
diff --git a/irc/getters.go b/irc/getters.go
index d7391cfa..18017764 100644
--- a/irc/getters.go
+++ b/irc/getters.go
@@ -812,6 +812,39 @@ func (channel *Channel) SetGreeting(greeting string) {
 	channel.greeting = greeting
 }
 
+func (channel *Channel) Notes() []ChannelNote {
+	channel.stateMutex.RLock()
+	defer channel.stateMutex.RUnlock()
+	return slices.Clone(channel.notes)
+}
+
+// AddNote appends a note unless the channel already holds `limit`; it returns the new note's number, or 0.
+func (channel *Channel) AddNote(account, text string, limit int) int {
+	defer channel.MarkDirty(IncludeSettings)
+
+	channel.stateMutex.Lock()
+	defer channel.stateMutex.Unlock()
+	if len(channel.notes) >= limit {
+		return 0
+	}
+	id := 1
+	for _, n := range channel.notes {
+		id = max(id, n.ID+1)
+	}
+	channel.notes = append(channel.notes, ChannelNote{ID: id, Account: account, Time: time.Now().UTC(), Text: text})
+	return id
+}
+
+func (channel *Channel) DeleteNote(id int) bool {
+	defer channel.MarkDirty(IncludeSettings)
+
+	channel.stateMutex.Lock()
+	defer channel.stateMutex.Unlock()
+	before := len(channel.notes)
+	channel.notes = slices.DeleteFunc(channel.notes, func(n ChannelNote) bool { return n.ID == id })
+	return len(channel.notes) != before
+}
+
 func (channel *Channel) SetSettings(settings ChannelSettings) {
 	defer channel.MarkDirty(IncludeSettings)
 
