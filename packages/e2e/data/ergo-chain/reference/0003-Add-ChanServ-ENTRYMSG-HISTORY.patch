From f89cf402fb1d5c645d316fde706b6230b2326380 Mon Sep 17 00:00:00 2001
From: ergo-dev <dev@example.invalid>
Date: Tue, 17 Nov 2026 18:11:55 -0800
Subject: [PATCH 03/12] Add ChanServ ENTRYMSG HISTORY

---
 irc/channel.go    |  4 ++++
 irc/channelreg.go | 10 ++++++++++
 irc/chanserv.go   | 32 ++++++++++++++++++++++++++++++--
 irc/getters.go    | 15 ++++++++++++++-
 4 files changed, 58 insertions(+), 3 deletions(-)

diff --git a/irc/channel.go b/irc/channel.go
index 14adda61..51098968 100644
--- a/irc/channel.go
+++ b/irc/channel.go
@@ -62,6 +62,7 @@ type Channel struct {
 	metadata          map[string]string
 	greeting          string
 	notes             []ChannelNote
+	greetingLog       []GreetingChange
 	// these caches are paired to allow iteration over channel members without holding the lock
 	membersCache    []*Client
 	memberDataCache []*memberData
@@ -136,6 +137,7 @@ func (channel *Channel) applyRegInfo(chanReg RegisteredChannel) {
 	channel.metadata = chanReg.Metadata
 	channel.greeting = chanReg.Greeting
 	channel.notes = slices.Clone(chanReg.Notes)
+	channel.greetingLog = slices.Clone(chanReg.GreetingLog)
 
 	for _, mode := range chanReg.Modes {
 		channel.flags.SetMode(mode, true)
@@ -176,6 +178,7 @@ func (channel *Channel) ExportRegistration() (info RegisteredChannel) {
 	info.Metadata = channel.metadata
 	info.Greeting = channel.greeting
 	info.Notes = slices.Clone(channel.notes)
+	info.GreetingLog = slices.Clone(channel.greetingLog)
 
 	return
 }
@@ -344,6 +347,7 @@ func (channel *Channel) SetUnregistered(expectedFounder string) {
 	channel.accountToUMode = make(map[string]modes.Mode)
 	channel.greeting = ""
 	channel.notes = nil
+	channel.greetingLog = nil
 	// reset the UUID so that any re-registration will persist under
 	// a separate key:
 	channel.uuid = uuid
diff --git a/irc/channelreg.go b/irc/channelreg.go
index 7e02f21f..5bd9be1b 100644
--- a/irc/channelreg.go
+++ b/irc/channelreg.go
@@ -69,6 +69,16 @@ type RegisteredChannel struct {
 	Greeting string
 	// Notes are staff notes about the channel, oldest first
 	Notes []ChannelNote
+	// GreetingLog holds the latest greeting changes, oldest first
+	GreetingLog []GreetingChange
+}
+
+// GreetingChange is one change of a channel's greeting; Text is empty when it was removed.
+type GreetingChange struct {
+	Time    time.Time
+	Account string
+	Staff   bool
+	Text    string
 }
 
 // ChannelNote is one staff note on a registered channel.
diff --git a/irc/chanserv.go b/irc/chanserv.go
index 1d0739e0..51764b60 100644
--- a/irc/chanserv.go
+++ b/irc/chanserv.go
@@ -201,7 +201,7 @@ QUIT) are stored in your channel's history. Your options are:
 
 ENTRYMSG sets the greeting that ChanServ sends to everyone who joins the
 channel. Without text, it removes the greeting. Only the channel founder can
-change it.`,
+change it. ENTRYMSG #channel HISTORY lists the last changes.`,
 			helpShort:    `$bENTRYMSG$b sets the greeting for people joining a channel.`,
 			authRequired: true,
 			enabled:      chanregEnabled,
@@ -1015,12 +1015,16 @@ func csEntrymsgHandler(service *ircService, server *Server, client *Client, comm
 		service.Notice(rb, client.t("Insufficient privileges"))
 		return
 	}
+	if len(params) == 2 && strings.EqualFold(params[1], "history") {
+		csGreetingHistory(service, channel, client, rb)
+		return
+	}
 	greeting := strings.Join(params[1:], " ")
 	if utf8.RuneCountInString(greeting) > maxGreetingLength {
 		service.Notice(rb, fmt.Sprintf(client.t("Greetings can be at most %d characters long"), maxGreetingLength))
 		return
 	}
-	channel.SetGreeting(greeting)
+	channel.SetGreeting(greeting, client.AccountName(), channel.Founder() != client.Account())
 	if greeting == "" {
 		service.Notice(rb, fmt.Sprintf(client.t("Removed the greeting for %s"), channel.Name()))
 	} else {
@@ -1068,3 +1072,27 @@ func csNoteHandler(service *ircService, server *Server, client *Client, command
 		service.Notice(rb, client.t("Invalid parameters"))
 	}
 }
+
+// staffName is how an action by network staff is shown: founders see "network staff", staff see the account.
+func staffName(change GreetingChange, viewer *Client) string {
+	if change.Staff && !viewer.HasRoleCapabs("chanreg") {
+		return "network staff"
+	}
+	return change.Account
+}
+
+func csGreetingHistory(service *ircService, channel *Channel, client *Client, rb *ResponseBuffer) {
+	log := channel.GreetingLog()
+	if len(log) == 0 {
+		service.Notice(rb, fmt.Sprintf(client.t("The greeting of %s has never been changed"), channel.Name()))
+	}
+	for i := len(log) - 1; i >= 0; i-- {
+		c := log[i]
+		when := c.Time.UTC().Format(time.RFC3339)
+		if c.Text == "" {
+			service.Notice(rb, fmt.Sprintf("%s %s removed the greeting", when, staffName(c, client)))
+		} else {
+			service.Notice(rb, fmt.Sprintf("%s %s set: %s", when, staffName(c, client), c.Text))
+		}
+	}
+}
diff --git a/irc/getters.go b/irc/getters.go
index 18017764..5cb8259f 100644
--- a/irc/getters.go
+++ b/irc/getters.go
@@ -804,12 +804,25 @@ func (channel *Channel) Greeting() string {
 	return channel.greeting
 }
 
-func (channel *Channel) SetGreeting(greeting string) {
+const greetingLogLength = 10
+
+// SetGreeting changes the greeting and records who changed it (staff: a chanreg operator who is not the founder).
+func (channel *Channel) SetGreeting(greeting, account string, staff bool) {
 	defer channel.MarkDirty(IncludeSettings)
 
 	channel.stateMutex.Lock()
 	defer channel.stateMutex.Unlock()
 	channel.greeting = greeting
+	channel.greetingLog = append(channel.greetingLog, GreetingChange{Time: time.Now().UTC(), Account: account, Staff: staff, Text: greeting})
+	if len(channel.greetingLog) > greetingLogLength {
+		channel.greetingLog = slices.Clone(channel.greetingLog[len(channel.greetingLog)-greetingLogLength:])
+	}
+}
+
+func (channel *Channel) GreetingLog() []GreetingChange {
+	channel.stateMutex.RLock()
+	defer channel.stateMutex.RUnlock()
+	return slices.Clone(channel.greetingLog)
 }
 
 func (channel *Channel) Notes() []ChannelNote {
-- 
