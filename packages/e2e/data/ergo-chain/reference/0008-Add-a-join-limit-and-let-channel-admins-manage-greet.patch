+
+func csJoinLimitHandler(service *ircService, server *Server, client *Client, command string, params []string, rb *ResponseBuffer) {
+	channel := server.channels.Get(params[0])
+	if channel == nil || !channel.IsRegistered() {
+		service.Notice(rb, client.t("Channel is not registered"))
+		return
+	}
+	if !(channel.Founder() == client.Account() || client.HasRoleCapabs("chanreg") || channel.ClientIsAtLeast(client, modes.ChannelAdmin)) {
+		service.Notice(rb, client.t("Insufficient privileges"))
+		return
+	}
+	if strings.EqualFold(params[1], "off") {
+		channel.SetJoinLimit(nil)
+		service.Notice(rb, fmt.Sprintf(client.t("Removed the join limit of %s"), channel.Name()))
+		return
+	}
+	joins, err1 := strconv.Atoi(params[1])
+	seconds, err2 := 0, error(nil)
+	if len(params) > 2 {
+		seconds, err2 = strconv.Atoi(params[2])
+	}
+	if err1 != nil || err2 != nil || joins < 1 || seconds < 1 {
+		service.Notice(rb, client.t("Invalid parameters"))
+		return
+	}
+	channel.SetJoinLimit(&ChannelJoinLimit{Joins: joins, Seconds: seconds})
+	service.Notice(rb, fmt.Sprintf(client.t("%s now takes at most %d joins every %d seconds"), channel.Name(), joins, seconds))
+}
diff --git a/irc/getters.go b/irc/getters.go
index dd6d088c..aee01b4a 100644
--- a/irc/getters.go
+++ b/irc/getters.go
@@ -828,6 +828,41 @@ func (channel *Channel) SetExpiryWarned() {
 	channel.expiryWarned = true
 }
 
+// JoinLimit returns the channel's join limit, or nil when it has none.
+func (channel *Channel) JoinLimit() *ChannelJoinLimit {
+	channel.stateMutex.RLock()
+	defer channel.stateMutex.RUnlock()
+	return channel.joinLimit
+}
+
+func (channel *Channel) SetJoinLimit(limit *ChannelJoinLimit) {
+	defer channel.MarkDirty(IncludeSettings)
+
+	channel.stateMutex.Lock()
+	defer channel.stateMutex.Unlock()
+	channel.joinLimit = limit
+	channel.joinLimitTripped = false
+}
+
+// joinLimitReached returns the join limit when it is used up at the moment (nil otherwise), and whether this is the
+// first time since people were last let in.
+func (channel *Channel) joinLimitReached() (limit *ChannelJoinLimit, first bool) {
+	channel.stateMutex.Lock()
+	defer channel.stateMutex.Unlock()
+	if channel.joinLimit == nil {
+		return nil, false
+	}
+	cutoff := time.Now().Add(-time.Duration(channel.joinLimit.Seconds) * time.Second)
+	channel.recentJoins = slices.DeleteFunc(channel.recentJoins, func(t time.Time) bool { return t.Before(cutoff) })
+	if len(channel.recentJoins) < channel.joinLimit.Joins {
+		channel.joinLimitTripped = false
+		return nil, false
+	}
+	first = !channel.joinLimitTripped
+	channel.joinLimitTripped = true
+	return channel.joinLimit, first
+}
+
 func (channel *Channel) Greeting() string {
 	channel.stateMutex.RLock()
 	defer channel.stateMutex.RUnlock()
