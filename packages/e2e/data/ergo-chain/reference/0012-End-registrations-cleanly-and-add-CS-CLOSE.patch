diff --git a/irc/channelmanager.go b/irc/channelmanager.go
index 5cfc60d8..afdb5a5f 100644
--- a/irc/channelmanager.go
+++ b/irc/channelmanager.go
@@ -4,12 +4,18 @@
 package irc
 
 import (
+	"bytes"
+	"errors"
+	"fmt"
+	"net/textproto"
 	"sort"
 	"sync"
 	"time"
 
 	"github.com/ergochat/ergo/irc/datastore"
+	"github.com/ergochat/ergo/irc/email"
 	"github.com/ergochat/ergo/irc/modes"
+	"github.com/ergochat/ergo/irc/sno"
 	"github.com/ergochat/ergo/irc/utils"
 )
 
@@ -244,20 +250,61 @@ func (cm *ChannelManager) SetRegistered(channelName string, account string) (err
 	return nil
 }
 
-func (cm *ChannelManager) SetUnregistered(channelName string, account string) (err error) {
+func (cm *ChannelManager) SetUnregistered(channelName string, account string, reason string) (err error) {
 	cfname, err := CasefoldChannel(channelName)
 	if err != nil {
 		return err
 	}
 
 	var uuid utils.UUID
+	var displayName string
 
 	defer func() {
-		if err == nil {
-			if delErr := cm.server.dstore.Delete(datastore.TableChannels, uuid); delErr != nil {
-				cm.server.logger.Error("datastore", "couldn't delete channel registration", cfname, delErr.Error())
-			}
+		if err != nil || displayName == "" {
+			return
+		}
+		if delErr := cm.server.dstore.Delete(datastore.TableChannels, uuid); delErr != nil {
+			cm.server.logger.Error("datastore", "couldn't delete channel registration", cfname, delErr.Error())
+		}
+		config := cm.server.Config()
+		founder, loadErr := cm.server.accounts.LoadAccount(account)
+		founderName := account
+		if loadErr == nil {
+			founderName = founder.Name
+		}
+		cm.server.snomasks.Send(sno.LocalChannels, fmt.Sprintf("The registration of %s (founder %s) ended: %s", displayName, founderName, reason))
+		for _, c := range cm.server.accounts.AccountToClients(account) {
+			c.Send(nil, ergoServicesByCommandAlias["CHANSERV"].prefix, "NOTICE", c.Nick(), fmt.Sprintf("[%s] The registration of this channel has ended: %s", displayName, reason))
 		}
+		if loadErr != nil || founder.Settings.Email == "" {
+			return
+		}
+		network, mailConfig := config.Network.Name, config.Accounts.Registration.EmailVerification
+		body := fmt.Sprintf("The registration of %s has ended: %s.\r\n", displayName, reason)
+		if after := time.Duration(*config.Channels.Registration.ExpireAfter); after > 0 {
+			body += fmt.Sprintf("If it is registered again, the registration is kept for %d days if nobody with an account joins the channel.\r\n", int(after.Hours()/24))
+		}
+		go func() {
+			mailMutex.Lock()
+			defer mailMutex.Unlock()
+			message := email.ComposeMail(mailConfig, founder.Settings.Email, fmt.Sprintf("[%s] The registration of %s has ended", network, displayName))
+			message = *bytes.NewBuffer(bytes.Replace(message.Bytes(), []byte("\r\n\r\n"), []byte("\r\nAuto-Submitted: auto-generated\r\n\r\n"), 1))
+			message.WriteString(body + "\r\n-- " + network + " staff\r\n")
+			var sendErr error
+			for attempt := 0; attempt < 3; attempt++ {
+				if sendErr = email.SendMail(mailConfig, founder.Settings.Email, message.Bytes()); sendErr == nil {
+					break
+				}
+				var smtpErr *textproto.Error
+				if !errors.As(sendErr, &smtpErr) || smtpErr.Code/100 != 4 {
+					break
+				}
+				time.Sleep(3 * time.Second)
+			}
+			if sendErr != nil {
+				cm.server.logger.Error("internal", "Failed to mail the founder of a channel", founder.Settings.Email, sendErr.Error())
+			}
+		}()
 	}()
 
 	cm.Lock()
@@ -268,6 +315,7 @@ func (cm *ChannelManager) SetUnregistered(channelName string, account string) (e
 			return errChannelNotOwnedByAccount
 		}
 		uuid = entry.channel.UUID()
+		displayName = entry.channel.Name()
 		entry.channel.SetUnregistered(account) // changes the UUID
 		// #1619: if the channel has 0 members and was only being retained
 		// because it was registered, clean it up:
@@ -523,3 +571,6 @@ func (cm *ChannelManager) AllRegisteredChannels() (result []string) {
 
 	return
 }
+
+// mailMutex lets one mail about a channel go out at a time: the network's mail relay takes one connection at a time.
+var mailMutex sync.Mutex
diff --git a/irc/chanserv.go b/irc/chanserv.go
index 5e794637..34e8cea6 100644
--- a/irc/chanserv.go
+++ b/irc/chanserv.go
@@ -252,6 +252,19 @@ operators by email, and NOTE adds a note to a channel.`,
 			maxParams:         3,
 			unsplitFinalParam: true,
 		},
+		"close": {
+			handler: csCloseHandler,
+			help: `Syntax: $bCLOSE #channel <reason>$b
+
+CLOSE ends the registration of a channel. The founder is told why, as coming
+from network staff.`,
+			helpShort:         `$bCLOSE$b ends a channel's registration.`,
+			capabs:            []string{"chanreg"},
+			enabled:           chanregEnabled,
+			minParams:         2,
+			maxParams:         2,
+			unsplitFinalParam: true,
+		},
 		"note": {
 			handler: csNoteHandler,
 			help: `Syntax: $bNOTE #channel ADD <text>$b
@@ -609,7 +622,7 @@ func csUnregisterHandler(service *ircService, server *Server, client *Client, co
 		return
 	}
 
-	server.channels.SetUnregistered(channelKey, info.Founder)
+	server.channels.SetUnregistered(channelKey, info.Founder, "the founder dropped it")
 	service.Notice(rb, fmt.Sprintf(client.t("Channel %s is now unregistered"), channelKey))
 }
 
@@ -1415,3 +1428,18 @@ func csReportHandler(service *ircService, server *Server, client *Client, comman
 		}
 	}()
 }
+
+func csCloseHandler(service *ircService, server *Server, client *Client, command string, params []string, rb *ResponseBuffer) {
+	channel := server.channels.Get(params[0])
+	if channel == nil || !channel.IsRegistered() {
+		service.Notice(rb, client.t("Channel is not registered"))
+		return
+	}
+	name := channel.Name()
+	if err := server.channels.SetUnregistered(channel.NameCasefolded(), channel.Founder(), "network staff closed it: "+strings.Join(params[1:], " ")); err != nil {
+		service.Notice(rb, client.t("An error occurred"))
+		return
+	}
+	service.Notice(rb, fmt.Sprintf(client.t("Closed %s"), name))
+	server.snomasks.Send(sno.LocalChannels, fmt.Sprintf("STAFF %s CLOSE %s", client.AccountName(), name))
+}
