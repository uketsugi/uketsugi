From e399113656f0c4d7a8da680f0c128b8909edb87c Mon Sep 17 00:00:00 2001
From: bench <bench@example.invalid>
Date: Tue, 17 Nov 2026 19:39:11 -0800
Subject: [PATCH 07/12] Show more in CS INFO

---
 irc/chanserv.go | 23 +++++++++++++++++++++++
 1 file changed, 23 insertions(+)

diff --git a/irc/chanserv.go b/irc/chanserv.go
index 479e0aee..0a1e6276 100644
--- a/irc/chanserv.go
+++ b/irc/chanserv.go
@@ -866,6 +866,29 @@ func csInfoHandler(service *ircService, server *Server, client *Client, command
 		}
 		service.Notice(rb, strings.TrimSpace(line))
 	}
+	lastUsed := channel.LastUsed().UTC()
+	service.Notice(rb, fmt.Sprintf(client.t("Last used: %s"), lastUsed.Format(time.RFC3339)))
+	if expireAfter := time.Duration(*server.Config().Channels.Registration.ExpireAfter); expireAfter > 0 {
+		service.Notice(rb, fmt.Sprintf(client.t("Expires: %s, if nobody uses it"), lastUsed.Add(expireAfter).Format(time.RFC3339)))
+	}
+	if greeting := channel.Greeting(); greeting == "" {
+		service.Notice(rb, client.t("Greeting: none"))
+	} else {
+		lead := client.t("Greeting: ")
+		room := 510 - len(":"+service.prefix+" NOTICE "+client.Nick()+" :")
+		for text := greeting; text != ""; lead = "" {
+			cut := min(len(text), room-len(lead))
+			for cut < len(text) && !utf8.RuneStart(text[cut]) {
+				cut--
+			}
+			service.Notice(rb, lead+text[:cut])
+			text = text[cut:]
+		}
+	}
+	if client.Account() == chinfo.Founder || client.HasRoleCapabs("chanreg") {
+		config := server.Config().Channels.Registration
+		service.Notice(rb, fmt.Sprintf(client.t("Notes: %d of %d"), len(channel.Notes()), config.NotesMax))
+	}
 }
 
 func displayChannelSetting(service *ircService, settingName string, settings ChannelSettings, client *Client, rb *ResponseBuffer) {
