diff --git a/irc/chanexpire.go b/irc/chanexpire.go
new file mode 100644
index 00000000..9f129272
--- /dev/null
+++ b/irc/chanexpire.go
@@ -0,0 +1,85 @@
+// released under the MIT license
+
+package irc
+
+import (
+	"bytes"
+	"errors"
+	"fmt"
+	"net/textproto"
+	"time"
+
+	"github.com/ergochat/ergo/irc/email"
+)
+
+// expireChannels runs once at start-up and then on a timer: registered channels that nobody with an account has
+// joined for `expire-after` lose their registration, and their founders are mailed a warning before and a note after.
+func (server *Server) expireChannels() {
+	config := server.Config()
+	after, warning := time.Duration(*config.Channels.Registration.ExpireAfter), time.Duration(*config.Channels.Registration.ExpireWarning)
+	next := time.Hour
+	if after > 0 && after/4 < next {
+		next = after / 4
+	}
+	defer func() { time.AfterFunc(next, server.expireChannels) }()
+	if after == 0 {
+		return
+	}
+
+	type outgoing struct{ to, subject, body string }
+	var outbox []outgoing
+	network := config.Network.Name
+	now := time.Now().UTC()
+	for _, channel := range server.channels.Channels() {
+		if !channel.IsRegistered() {
+			continue
+		}
+		founder, name := channel.Founder(), channel.Name()
+		if channel.HasAccountMembers() {
+			channel.SetLastUsed(now)
+			continue
+		}
+		expires := channel.LastUsed().Add(after)
+		var to string
+		if account, err := server.accounts.LoadAccount(founder); err == nil {
+			to = account.Settings.Email
+		}
+		if !now.Before(expires) {
+			if server.channels.SetUnregistered(channel.NameCasefolded(), founder) == nil && to != "" {
+				outbox = append(outbox, outgoing{to, fmt.Sprintf("[%s] %s has expired", network, name),
+					fmt.Sprintf("Nobody with an account has joined %s for %s, so its registration has expired.\r\n", name, after)})
+			}
+		} else if warning > 0 && !now.Before(expires.Add(-warning)) && !channel.ExpiryWarned() {
+			channel.SetExpiryWarned()
+			for _, c := range server.accounts.AccountToClients(founder) {
+				c.Send(nil, chanservService.prefix, "NOTICE", c.Nick(), fmt.Sprintf("[%s] %s", name,
+					fmt.Sprintf(c.t("Nobody with an account has joined this channel for a while; its registration will expire on %s unless someone does"), expires.Format(time.RFC3339))))
+			}
+			if to != "" {
+				outbox = append(outbox, outgoing{to, fmt.Sprintf("[%s] %s will expire on %s", network, name, expires.Format(time.RFC3339)),
+					fmt.Sprintf("Nobody with an account has joined %s for a while. Its registration will expire on %s unless someone joins.\r\n", name, expires.Format(time.RFC3339))})
+			}
+		}
+	}
+
+	mailConfig := config.Accounts.Registration.EmailVerification
+	for _, m := range outbox {
+		message := email.ComposeMail(mailConfig, m.to, m.subject)
+		message = *bytes.NewBuffer(bytes.Replace(message.Bytes(), []byte("\r\n\r\n"), []byte("\r\nAuto-Submitted: auto-generated\r\n\r\n"), 1))
+		message.WriteString(m.body + "\r\n-- " + network + " staff\r\n")
+		var err error
+		for attempt := 0; attempt < 3; attempt++ {
+			if err = email.SendMail(mailConfig, m.to, message.Bytes()); err == nil {
+				break
+			}
+			var smtpErr *textproto.Error
+			if !errors.As(err, &smtpErr) || smtpErr.Code/100 != 4 {
+				break
+			}
+			time.Sleep(3 * time.Second)
+		}
+		if err != nil {
+			server.logger.Error("internal", "Failed to mail channel founder", m.to, err.Error())
+		}
+	}
+}
