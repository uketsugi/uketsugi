diff --git a/irc/getters.go b/irc/getters.go
index c7704219..dd6d088c 100644
--- a/irc/getters.go
+++ b/irc/getters.go
@@ -798,6 +798,36 @@ func (channel *Channel) Settings() (result ChannelSettings) {
 	return result
 }
 
+// LastUsed is when someone with an account last joined the channel (when it was registered, if nobody has since).
+func (channel *Channel) LastUsed() time.Time {
+	channel.stateMutex.RLock()
+	defer channel.stateMutex.RUnlock()
+	return channel.lastUsed
+}
+
+func (channel *Channel) SetLastUsed(t time.Time) {
+	defer channel.MarkDirty(IncludeSettings)
+
+	channel.stateMutex.Lock()
+	defer channel.stateMutex.Unlock()
+	channel.lastUsed = t
+	channel.expiryWarned = false
+}
+
+func (channel *Channel) ExpiryWarned() bool {
+	channel.stateMutex.RLock()
+	defer channel.stateMutex.RUnlock()
+	return channel.expiryWarned
+}
+
+func (channel *Channel) SetExpiryWarned() {
+	defer channel.MarkDirty(IncludeSettings)
+
+	channel.stateMutex.Lock()
+	defer channel.stateMutex.Unlock()
+	channel.expiryWarned = true
+}
+
 func (channel *Channel) Greeting() string {
 	channel.stateMutex.RLock()
 	defer channel.stateMutex.RUnlock()
@@ -1198,3 +1228,13 @@ func (client *Client) checkMetadataThrottle() (throttled bool, remainingTime tim
 	client.metadataThrottle = throttle.ThrottleDetails
 	return
 }
+
+// HasAccountMembers says whether anyone with an account is in the channel at the moment.
+func (channel *Channel) HasAccountMembers() bool {
+	for _, member := range channel.Members() {
+		if member.LoggedIntoAccount() {
+			return true
+		}
+	}
+	return false
+}
